# Public Firebase web app settings (Firebase console > Project settings).
# Copy to .env.local and replace every required value.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
# Optional: leave blank if Analytics is not configured.
VITE_FIREBASE_MEASUREMENT_ID=
# Optional: defaults to http://localhost:3001 where supported.
VITE_SOCKET_SERVER_URL=http://localhost:3001
